{
  "name": "agent-browser-service",
  "version": "1.0.0",
  "private": true,
  "description": "HTTP wrapper around agent-browser for URL content extraction",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "postinstall": "npx agent-browser install 2>/dev/null || true"
  },
  "dependencies": {
    "agent-browser": "^0.17.0",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
